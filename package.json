{
  "name": "doar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "tsc -b && oxlint && node --experimental-strip-types scripts/check-rules.ts && node --experimental-strip-types scripts/check-webpush.ts && node --experimental-strip-types scripts/check-postman.ts",
    "check:ui": "node --experimental-strip-types scripts/check-ui.ts",
    "preview": "vite preview",
    "android": "npm run build && cap sync android && cap open android",
    "sync": "npm run build && cap sync android",
    "android:live": "node scripts/android-live.mjs",
    "android:install": "npm run sync && cd android && .\\gradlew.bat installDebug",
    "android:pair": "node scripts/android-pair.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "@use-gesture/react": "^10.3.1",
    "dompurify": "^3.4.17",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
