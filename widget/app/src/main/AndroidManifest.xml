<?xml version="1.0" encoding="utf-8"?>
<!--
  Doar's home-screen widget. No screen of its own and no icon among the apps: it is
  connected from Doar's settings (a link that opens ConnectActivity with a key), and it
  lives in the widget picker. Everything a tap opens is Doar itself, in Chrome.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Refreshing waits for a connection, which needs to see the network's state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- So the quarter-hourly refresh survives a restart of the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- To find Doar as installed from Chrome and open letters there. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="doar-henna.vercel.app" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <receiver
            android:name=".MailWidget"
            android:label="@string/widget_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mail_widget" />
        </receiver>

        <service
            android:name=".RefreshJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Doar's settings hand the key over: doarwidget://connect?key=… -->
        <activity
            android:name=".ConnectActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doarwidget" android:host="connect" />
            </intent-filter>
        </activity>

        <!-- A tap on the widget passes through here on its way to Doar. -->
        <activity
            android:name=".OpenActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:exported="false" />
    </application>
</manifest>
