# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
# Both values are safe to ship in the app; the publishable key only allows what
# Row Level Security and the Edge Functions allow.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
