<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/paper"
    android:clipToOutline="true"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginStart="@android:dimen/system_app_widget_background_radius"
        android:layout_marginEnd="@android:dimen/system_app_widget_background_radius"
        android:background="@drawable/airmail" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/title_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/press"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="@string/title"
                android:textColor="@color/ink_red"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text=""
                android:textAlignment="viewStart"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/press_round"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/compose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/press_round"
            android:contentDescription="@string/compose"
            android:src="@drawable/ic_compose" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/ink_rule" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/rule"
            android:dividerHeight="1dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/press"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
